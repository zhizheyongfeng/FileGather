<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileGather.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
        x:Class="FileGather.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="文件收集器 - FileGather"
        Width="900" Height="680"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Margin="12,8,12,12" Padding="10,8"
                BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <ProgressBar DockPanel.Dock="Right"
                             Width="220" Height="8" VerticalAlignment="Center"
                             Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsTransferring}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <ScrollViewer Margin="12,12,12,4">
            <StackPanel Spacing="8">

                <!-- ① 源文件夹 -->
                <TextBlock Text="① 选择源文件夹" FontWeight="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding SourcePath}"
                             PlaceholderText="例如：C:\Users\你的名字\Documents" />
                    <Button Grid.Column="1" Content="浏览…" Padding="16,6"
                            Command="{Binding BrowseSourceCommand}"
                            CommandParameter="{Binding #Root}" />
                </Grid>

                <!-- ② 筛选条件 -->
                <TextBlock Text="② 设置筛选条件" FontWeight="Bold" Margin="0,10,0,0" />
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="6">
                        <TextBlock Text="文件扩展名：" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Extensions}"
                                 PlaceholderText="逗号分隔，如 docx,doc,pdf" />
                    </Grid>
                    <Grid ColumnDefinitions="110,*" ColumnSpacing="6">
                        <TextBlock Text="文件名关键词：" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Keyword}"
                                 PlaceholderText="可选，留空表示不过滤" />
                    </Grid>
                    <CheckBox Content="包含子文件夹（递归检索）" IsChecked="{Binding IncludeSubfolders}" />
                </StackPanel>

                <Button Content="开始检索" Padding="0,8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />

                <!-- ③ 检索结果 -->
                <TextBlock Text="③ 检索结果" FontWeight="Bold" Margin="0,10,0,0" />
                <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="Gray" />
                <ListBox ItemsSource="{Binding Results}" Height="200"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,80,120" ColumnSpacing="8">
                                <TextBlock Text="{Binding Extension}" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                           HorizontalAlignment="Right" Foreground="Gray" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}"
                                           Foreground="Gray" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ④ 目标文件夹 -->
                <TextBlock Text="④ 选择目标文件夹" FontWeight="Bold" Margin="0,10,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding TargetPath}"
                             PlaceholderText="选择存放收集文件的文件夹" />
                    <Button Grid.Column="1" Content="浏览…" Padding="16,6"
                            Command="{Binding BrowseTargetCommand}"
                            CommandParameter="{Binding #Root}" />
                </Grid>

                <!-- 操作方式 -->
                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,6,0,0">
                    <RadioButton Content="复制（保留源文件）" IsChecked="{Binding !IsMove}" />
                    <RadioButton Content="移动（源文件将被移除）" IsChecked="{Binding IsMove}" />
                </StackPanel>

                <!-- 执行按钮 -->
                <Button Content="开始执行" Padding="0,8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding TransferCommand}"
                        IsEnabled="{Binding !IsTransferring}"
                        IsVisible="{Binding HasResults}" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
