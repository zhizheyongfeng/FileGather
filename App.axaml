<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileGather.App"
             xmlns:local="using:FileGather"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E1E1E1" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="AppEmptyStateBackgroundBrush" Color="#FAFAFA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#9E9E9E" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="AppEmptyStateBackgroundBrush" Color="#1E1E1E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
